{
    "version": 2,
    "platforms": {
        "chatgpt": {
            "textarea": "#prompt-textarea",
            "response": ".markdown.prose",
            "sendBtn": "[data-testid='send-button']",
            "model": "[data-testid='model-switcher-dropdown-button']"
        },
        "claude": {
            "textarea": "[contenteditable='true'].ProseMirror",
            "response": ".font-claude-message",
            "sendBtn": "[aria-label='Send message']",
            "model": ".model-selector-value"
        },
        "gemini": {
            "textarea": "rich-textarea .ql-editor",
            "response": ".model-response-text",
            "sendBtn": ".send-button",
            "model": ".model-selector"
        },
        "deepseek": {
            "textarea": "textarea#chat-input, textarea[placeholder], div[contenteditable='true'][data-lexical-editor]",
            "response": ".ds-markdown, .markdown-body, [class*='markdown'], [class*='message-content']",
            "sendBtn": "[aria-label='Send'], button[type='submit'], .send-btn",
            "model": ".model-name, [class*='model']"
        },
        "perplexity": {
            "textarea": "textarea[placeholder*='Ask'], textarea[name='q'], div[contenteditable='true']",
            "response": ".prose, [class*='answer'], [class*='markdown'], [data-testid='answer']",
            "sendBtn": "button[aria-label='Submit'], button[type='submit']",
            "model": "[class*='model'], [class*='focus']"
        }
    }
}
